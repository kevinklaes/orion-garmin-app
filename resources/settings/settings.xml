<?xml version="1.0" encoding="UTF-8"?>
<settings>
    <group id="orionAuth" title="@Strings.AuthGroupTitle" description="@Strings.AuthGroupDesc">
        <setting propertyKey="@Properties.api_key" title="@Strings.ApiKeyTitle" prompt="@Strings.ApiKeyPrompt">
            <settingConfig type="password" required="false" maxLength="64"/>
        </setting>
        <setting propertyKey="@Properties.phone" title="@Strings.PhoneTitle" prompt="@Strings.PhonePrompt">
            <settingConfig type="alphaNumeric" required="false" maxLength="15"/>
        </setting>
    </group>
    <group id="orionBed" title="@Strings.BedGroupTitle">
        <setting propertyKey="@Properties.primary_side" title="@Strings.PrimarySideTitle" prompt="@Strings.PrimarySidePrompt">
            <settingConfig type="list">
                <listEntry value="0">@Strings.PrimarySideA</listEntry>
                <listEntry value="1">@Strings.PrimarySideB</listEntry>
            </settingConfig>
        </setting>
    </group>
    <group id="orionBackend" title="@Strings.BackendGroupTitle" description="@Strings.BackendGroupDesc">
        <setting propertyKey="@Properties.backend" title="@Strings.BackendTitle" prompt="@Strings.BackendPrompt">
            <settingConfig type="list">
                <listEntry value="0">@Strings.BackendOrion</listEntry>
                <listEntry value="1">@Strings.BackendEmberTide</listEntry>
            </settingConfig>
        </setting>
        <setting propertyKey="@Properties.et_url" title="@Strings.EtUrlTitle" prompt="@Strings.EtUrlPrompt">
            <settingConfig type="alphaNumeric" required="false" maxLength="200"/>
        </setting>
        <setting propertyKey="@Properties.et_key" title="@Strings.EtKeyTitle" prompt="@Strings.EtKeyPrompt">
            <settingConfig type="password" required="false" maxLength="128"/>
        </setting>
    </group>
</settings>
