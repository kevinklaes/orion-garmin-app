<?xml version="1.0" encoding="UTF-8"?>
<properties>
    <!-- Dev defaults empty — set via Garmin Connect Mobile app settings, or
         paste the API key here as a phone-side convenience. The OTP
         verification code itself is never a property: it's ephemeral
         (requested live, single use) so it's entered on-device in the
         provisioning flow (oga bead), not stored as static config. -->
    <property id="api_key" type="string"></property>
    <property id="phone" type="string"></property>
    <!-- Primary side of the bed: 0 = side A (zone_a), 1 = side B (zone_b).
         Read only through DeviceModel.primaryZoneId(). -->
    <property id="primary_side" type="number">0</property>
    <!-- Backend (oga-2cx): 0 = Orion cloud, 1 = Ember & Tide. The Ember &
         Tide address and key are used only when backend is 1. Read only
         through BackendConfig. -->
    <property id="backend" type="number">0</property>
    <property id="et_url" type="string"></property>
    <property id="et_key" type="string"></property>
</properties>
